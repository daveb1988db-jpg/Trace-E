# Trace-E speak_server TTS — copy to .env (never commit real keys)
# Keys are also auto-loaded from peanut-robot/.env if present.
# Accept terms / get keys: see desktop/TTS_KEYS.md

# Dual cloud TTS (same names as Peanut)
# Groq: https://console.groq.com/keys
#   Accept Orpheus: https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey
#   Try TTS UI: https://aistudio.google.com/app/prompts/new_speech
#   Billing if needed: https://ai.google.dev/gemini-api/docs/billing
GEMINI_API_KEY=
# Optional Google alias:
# GOOGLE_API_KEY=

# Default TTS chain: Peanut Ana (edge-tts) → Groq → Gemini → Spidey? → pyttsx3
# TRACE_E_TTS_ENGINE=peanut-auto
# TRACE_E_ANA_VOICE=en-US-AnaNeural
# TRACE_E_ANA_RATE=-5%
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=hannah
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# TRACE_E_SPIDEY_TTS=1

# TRACE_E_ESP_BASE=http://192.168.1.104
# TRACE_E_SPEAK_PORT=8787
# TRACE_E_CHIRPS=off
